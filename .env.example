# Copy to .env. Never commit .env.
#
# Every value here is optional. With none of them set, the graph runs its
# degraded path end to end and the full eval harness passes, which is
# deliberate: a reader should be able to verify every claim in the README
# without an API key.

# none | anthropic | openai
DG_LLM_PROVIDER=none
DG_PRIMARY_MODEL=
DG_CHEAP_MODEL=
ANTHROPIC_API_KEY=

# memory | chroma
DG_VECTOR_STORE=memory
DG_CHROMA_DIR=.chroma

# identity | cross_encoder
DG_RERANKER=identity

MLFLOW_TRACKING_URI=file:./mlruns
DG_MLFLOW_EXPERIMENT=deduction-graph

# When true, reading an unverified rule parameter raises instead of warning.
DG_STRICT_VERIFIED=false

DG_LOG_LEVEL=INFO
